{
  "Statement": [
    {
      "Action": [
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeSecurityGroupRules"
      ],
      "Effect": "Allow",
      "Resource": "*",
      "Sid": "DescribeSecurityGroups"
    },
    {
      "Action": [
        "ec2:RevokeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupIngress",
        "ec2:DeleteSecurityGroup"
      ],
      "Condition": {
        "Null": {
          "ec2:ResourceTag/CommitSha": "false",
          "ec2:ResourceTag/Environment": "false",
          "ec2:ResourceTag/RunId": "false"
        },
        "StringEquals": {
          "ec2:ResourceTag/ManagedBy": "Terraform",
          "ec2:ResourceTag/Repository": "nwarila-platform/gitlab",
          "ec2:ResourceTag/RepositoryId": "<repository-id>"
        }
      },
      "Effect": "Allow",
      "Resource": "arn:aws:ec2:<region>:<account-id>:security-group/*",
      "Sid": "RevokeRulesAndDeleteOwnedGroupsOnly"
    },
    {
      "Action": [
        "ec2:RevokeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupIngress"
      ],
      "Effect": "Allow",
      "Resource": "arn:aws:ec2:<region>:<account-id>:security-group-rule/*",
      "Sid": "RevokeRuleObjectsInOwnedGroups"
    }
  ],
  "Version": "2012-10-17"
}
