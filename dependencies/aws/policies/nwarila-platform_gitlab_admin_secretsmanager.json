{
  "Statement": [
    {
      "Action": "secretsmanager:GetSecretValue",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/aws:rds:primaryDBInstanceArn": "arn:aws:rds:<region>:<account-id>:db:gitlab"
        }
      },
      "Effect": "Allow",
      "Resource": "arn:aws:secretsmanager:<region>:<account-id>:secret:rds!db-*",
      "Sid": "ReadOnlyTheGitLabMasterSecret"
    }
  ],
  "Version": "2012-10-17"
}
