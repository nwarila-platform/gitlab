{
  "Statement": [
    {
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceAccount": "<account-id>"
        }
      },
      "Effect": "Allow",
      "Resource": "arn:aws:s3:::<account-id>-gitlab-objects/runs/*",
      "Sid": "ReadWriteOnlyTheRunObjects"
    },
    {
      "Action": [
        "s3:AbortMultipartUpload",
        "s3:DeleteObject",
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceAccount": "<account-id>"
        }
      },
      "Effect": "Allow",
      "Resource": "arn:aws:s3:::<account-id>-gitlab-objects/tmp/uploads/*",
      "Sid": "ReadWriteTheDirectUploadTemporaries"
    },
    {
      "Action": "s3:ListBucket",
      "Condition": {
        "StringEquals": {
          "aws:ResourceAccount": "<account-id>"
        },
        "StringLike": {
          "s3:prefix": [
            "runs/*"
          ]
        }
      },
      "Effect": "Allow",
      "Resource": "arn:aws:s3:::<account-id>-gitlab-objects",
      "Sid": "ListOnlyTheRunsPrefix"
    }
  ],
  "Version": "2012-10-17"
}
