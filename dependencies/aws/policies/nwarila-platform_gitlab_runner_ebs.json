{
  "Statement": [
    {
      "Action": [
        "ec2:DescribeVolumes",
        "ec2:DescribeVolumeAttribute"
      ],
      "Effect": "Allow",
      "Resource": "*",
      "Sid": "DescribeVolumes"
    },
    {
      "Action": "ec2:CreateVolume",
      "Condition": {
        "Null": {
          "aws:RequestTag/CommitSha": "false",
          "aws:RequestTag/Environment": "false",
          "aws:RequestTag/RunId": "false"
        },
        "StringEquals": {
          "aws:RequestTag/ManagedBy": "Terraform",
          "aws:RequestTag/Repository": "nwarila-platform/gitlab",
          "aws:RequestTag/RepositoryId": "<repository-id>"
        }
      },
      "Effect": "Allow",
      "Resource": "*",
      "Sid": "CreateTaggedVolume"
    },
    {
      "Action": [
        "ec2:AttachVolume",
        "ec2:DetachVolume"
      ],
      "Condition": {
        "Null": {
          "ec2:ResourceTag/CommitSha": "false",
          "ec2:ResourceTag/Environment": "false",
          "ec2:ResourceTag/RunId": "false"
        },
        "StringEquals": {
          "ec2:ResourceTag/ManagedBy": "Terraform",
          "ec2:ResourceTag/Repository": "nwarila-platform/gitlab",
          "ec2:ResourceTag/RepositoryId": "<repository-id>"
        }
      },
      "Effect": "Allow",
      "Resource": [
        "arn:aws:ec2:<region>:<account-id>:volume/*",
        "arn:aws:ec2:<region>:<account-id>:instance/*"
      ],
      "Sid": "AttachDetachOwnedVolumeAndInstance"
    },
    {
      "Action": "ec2:DeleteVolume",
      "Condition": {
        "Null": {
          "ec2:ResourceTag/CommitSha": "false",
          "ec2:ResourceTag/Environment": "false",
          "ec2:ResourceTag/RunId": "false"
        },
        "StringEquals": {
          "ec2:ResourceTag/ManagedBy": "Terraform",
          "ec2:ResourceTag/Repository": "nwarila-platform/gitlab",
          "ec2:ResourceTag/RepositoryId": "<repository-id>"
        }
      },
      "Effect": "Allow",
      "Resource": "arn:aws:ec2:<region>:<account-id>:volume/*",
      "Sid": "DeleteOwnedVolume"
    }
  ],
  "Version": "2012-10-17"
}
