# =========================================================================================== #
# File: '.gitignore'
# --- [ Description ] ----------------------------------------------------------------------- #
#
# DEFAULT-DENY, EXPLICIT INCLUDES ONLY. Nothing in this working tree is tracked unless it is
# explicitly allowed below, by name — no wildcard allowances. Adding a new file therefore
# requires allowing it here first — that is deliberate: it makes publishing a file an
# explicit act rather than an accident.
#
# =========================================================================================== #

# Ignore everything ...
**

# --- [ directory spine ] -------------------------------------------------------------------- #
# Git does not descend into an excluded directory, so every directory on the path to an
# allowed file is re-included by name. This publishes no files by itself: files inside these
# directories stay ignored until named in a section below.
!/.github/
!/.github/workflows/
!/ansible/
!/ansible/applications/
!/ansible/applications/gitlab/
!/ansible/applications/gitlab/defaults/
!/ansible/applications/gitlab/files/
!/ansible/applications/gitlab/meta/
!/ansible/applications/gitlab/tasks/
!/ansible/applications/gitlab/templates/
!/ansible/applications/gitlab/vars/
!/ansible/inventory/
!/ansible/playbooks/
!/dependencies/
!/dependencies/aws/
!/dependencies/aws/policies/
!/dependencies/aws/roles/
!/scripts/
!/terraform/

# --- [ allowed: repository configuration ] -------------------------------------------------- #
!/.editorconfig
!/.gitignore
!/.yamllint.yml

# --- [ allowed: top-level documents ] ------------------------------------------------------- #
!/LICENSE
!/README.md
!/SECURITY.md
!/quality-tools.env
!/requirements-quality.txt
!/requirements-quality.yml

# --- [ allowed: GitHub configuration ] ------------------------------------------------------ #
!/.github/CODEOWNERS
!/.github/ansible-framework-pin
!/.github/renovate.json5
!/.github/terraform-framework-pin
!/.github/workflows/aws-deploy.yml
!/.github/workflows/aws-reaper.yml
!/.github/workflows/powershell.yml
!/.github/workflows/quality.yml

# --- [ allowed: the ansible tree ] ---------------------------------------------------------- #
!/ansible/applications/gitlab/README.md
!/ansible/applications/gitlab/defaults/main.yml
!/ansible/applications/gitlab/files/gitlab-package-signing-key.asc
!/ansible/applications/gitlab/meta/main.yml
!/ansible/applications/gitlab/tasks/main.yml
!/ansible/applications/gitlab/tasks/present_redhat.yml
!/ansible/applications/gitlab/tasks/validate.yml
!/ansible/applications/gitlab/templates/gitlab.rb.j2
!/ansible/applications/gitlab/vars/redhat.yml
!/ansible/inventory/README.md
!/ansible/inventory/aws_ec2.yml
!/ansible/playbooks/gitlab-aws.yml

# --- [ allowed: dependency declarations ] -------------------------------------------------- #
!/dependencies/MANIFEST.sha256
!/dependencies/README.md
!/dependencies/registry-values.yml
!/dependencies/aws/artifacts.yml
!/dependencies/aws/estate.yml
!/dependencies/aws/manifest.json
!/dependencies/aws/policies/nwarila-platform_gitlab_admin_s3.json
!/dependencies/aws/policies/nwarila-platform_gitlab_admin_secretsmanager.json
!/dependencies/aws/policies/nwarila-platform_gitlab_reaper_ebs.json
!/dependencies/aws/policies/nwarila-platform_gitlab_reaper_ec2.json
!/dependencies/aws/policies/nwarila-platform_gitlab_reaper_elb.json
!/dependencies/aws/policies/nwarila-platform_gitlab_reaper_eni.json
!/dependencies/aws/policies/nwarila-platform_gitlab_reaper_iam.json
!/dependencies/aws/policies/nwarila-platform_gitlab_reaper_rds.json
!/dependencies/aws/policies/nwarila-platform_gitlab_reaper_s3.json
!/dependencies/aws/policies/nwarila-platform_gitlab_reaper_sg.json
!/dependencies/aws/policies/nwarila-platform_gitlab_runner_ebs.json
!/dependencies/aws/policies/nwarila-platform_gitlab_runner_ec2.json
!/dependencies/aws/policies/nwarila-platform_gitlab_runner_elb.json
!/dependencies/aws/policies/nwarila-platform_gitlab_runner_eni.json
!/dependencies/aws/policies/nwarila-platform_gitlab_runner_iam.json
!/dependencies/aws/policies/nwarila-platform_gitlab_runner_kms.json
!/dependencies/aws/policies/nwarila-platform_gitlab_runner_rds.json
!/dependencies/aws/policies/nwarila-platform_gitlab_runner_s3.json
!/dependencies/aws/policies/nwarila-platform_gitlab_runner_sg.json
!/dependencies/aws/policies/nwarila-platform_gitlab_runner_ssm.json
!/dependencies/aws/roles/nwarila-platform_gitlab_admin.trust.json
!/dependencies/aws/roles/nwarila-platform_gitlab_admin.yml
!/dependencies/aws/roles/nwarila-platform_gitlab_reaper.trust.json
!/dependencies/aws/roles/nwarila-platform_gitlab_reaper.yml
!/dependencies/aws/roles/nwarila-platform_gitlab_runner.trust.json
!/dependencies/aws/roles/nwarila-platform_gitlab_runner.yml

# --- [ allowed: scripts ] ------------------------------------------------------------------- #
!/scripts/apply-dependencies.sh
!/scripts/check-dependencies.py
!/scripts/compose-and-run.sh
!/scripts/materialize-role-scripts.sh

# --- [ allowed: terraform (data-only; resources live in the pinned framework) ] -------------- #
!/terraform/README.md
!/terraform/aws.tfvars
